#compdef dfdu

autoload -U is-at-least

_dfdu() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'(--disks -f --file)--resume-from=[Open the scan saved in FILE (a snapshot or an ncdu export) at once, and rescan its directory in the background, replacing it when done]:FILE:_files' \
'(--disks)-f+[Browse a scan saved in FILE (a snapshot, an ncdu JSON export, plain or zstd, or an ncdu binary export from \`ncdu -O\`; \`-\` for stdin), read-only]:FILE:_files' \
'(--disks)--file=[Browse a scan saved in FILE (a snapshot, an ncdu JSON export, plain or zstd, or an ncdu binary export from \`ncdu -O\`; \`-\` for stdin), read-only]:FILE:_files' \
'(--disks -f --file --resume-from)--remote=[Browse PATH on HOST, scanned there by the dfdu agent through ssh (sent there if HOST has none, see --remote-agent) and classified with the rules of this host. The delete keys delete on HOST, unless --read-only; nothing is recorded in the history]:HOST:_default' \
'--remote-agent=[How to start the agent on HOST\: auto (an installed dfdu that speaks this one'\''s protocol, else one sent earlier, else send this version'\''s, asking first), installed, or upload (send one without asking) \[default\: auto, or DFDU_REMOTE_AGENT\]]:HOW:((auto\:"The installed dfdu if it speaks this one'\''s protocol, else one sent earlier, else send one (asking first)"
installed\:"The dfdu installed on the host, as \`ssh HOST dfdu agent\`"
upload\:"One sent earlier, else send one, without asking"))' \
'--type=[Show only files of these types or extensions, comma-separated\: \`video,audio,.iso\` (\`t\` in the browser changes it)]:TYPES:_default' \
'--theme=[Colour theme\: auto, dark, light, ansi (the terminal'\''s own 16 colours), mono, high-contrast, or NAME for the theme file NAME.toml in dfdu/themes in the configuration directory. auto asks the terminal for its background colour at start (up to 1 s if it does not answer) and picks dark or light, or ansi when the colour is unknown]:THEME:_default' \
'--color=[Colours\: auto (from the terminal and NO_COLOR), never, 16, 256 or truecolor. A level given here is used even when NO_COLOR is set]:WHEN:_default' \
'--bars=[Bars\: unicode (eighth blocks, the default) or ascii (# and =, for terminals and fonts without block characters). Overrides the theme file'\''s \`bars\`]:STYLE:_default' \
'-x[Stay on the filesystem of the scanned directory (the default; overrides --cross-mounts and --network given before it)]' \
'--one-file-system[Stay on the filesystem of the scanned directory (the default; overrides --cross-mounts and --network given before it)]' \
'--cross-mounts[Descend into other local filesystems (disks, tmpfs)]' \
'--network[Descend into network filesystems (NFS, SMB, sshfs and other FUSE network mounts); with or without --cross-mounts]' \
'--mft[Windows, as administrator\: read each NTFS volume'\''s master file table instead of listing its directories, which is much faster on large volumes. Volumes whose table cannot be read are listed as usual]' \
'--no-rules[Do not classify entries\: no categories, no cleanup candidates]' \
'()--disks[Choose a disk to browse from the mounted filesystems]' \
'--read-only[Never delete anything\: the browser leaves out its delete keys and runs cleanup commands only as dry runs]' \
'--no-history[Do not record the scan in the history, nor show what grew since the last one]' \
'--no-cache[Scan PATH afresh\: do not open its cached scan, nor save this one (\`DFDU_CACHE=0\` turns the cache off for good). Without it, the browser opens the last complete scan of PATH at once, if one is cached, and brings it up to date in the background; scans that take 3 s or more are cached for 14 days (\`dfdu cache list\`)]' \
'--no-mouse[Do not capture the mouse (click to select, double-click to open, wheel to scroll). While it is captured, most terminals select text with Shift held down]' \
'--debug-stats[Start with the debug panel open, and print its numbers when the browser exits]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
'::path -- Directory to browse (opens the interactive browser when stdout is a terminal):_files' \
":: :_dfdu_commands" \
"*::: :->dfdu" \
&& ret=0
    case $state in
    (dfdu)
        words=($line[2] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:dfdu-command-$line[2]:"
        case $line[2] in
            (scan)
_arguments "${_arguments_options[@]}" : \
'--format=[Output\: table (for people), json (one document, schema/scan.v1.json), ndjson (one record per line, for large trees) or ncdu (ncdu'\''s JSON export)]:FORMAT:(table json ndjson ncdu)' \
'--depth=[Levels of directories to print below the root \[default\: 1; every level for ndjson\]]:DEPTH:_default' \
