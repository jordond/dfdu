'--type=[Count only files of these types or extensions, comma-separated\: \`video,audio,.iso\`. Types\: video, audio, image, document, archive, disk-image, code, executable, font, data, other. Folders show the size of the matching files inside them]:TYPES:_default' \
'--stall-abandon=[Abandon directories stalled this many seconds]:STALL_ABANDON:_default' \
