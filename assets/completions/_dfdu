(( $+functions[_dfdu_commands] )) ||
_dfdu_commands() {
    local commands; commands=(
'scan:Scan a directory and print a summary' \
'disks:List the mounted filesystems with their size and free space' \
'report:Scan a directory and list what the cleanup rules found in it\: caches, build output, dependencies, with how safe each is to delete' \
'clean:Delete what \`report\` recommends (dry run unless --yes)' \
'diff:What grew\: a directory now against its last recorded scan (or one from --since ago), or two saved scans' \
'history:List the recorded scans' \
'dupes:Scan a directory and list the files with identical contents (size, then partial hash, then SHA-256), the most space to free first' \
'export:Scan a directory and write it in ncdu'\''s JSON format' \
'import:Read a scan in ncdu'\''s JSON format and print a summary (\`dfdu -f FILE\` browses it)' \
'recover:List what earlier sessions left unfinished (staged items, interrupted deletes), and finish, restore or dismiss them' \
'cache:List or clear the scans the browser cached, which it opens at once next time' \
'man:Write man pages (dfdu.1 and one per command) into DIR, for packagers' \
'completions:Print a shell completion script (bash, zsh, fish, elvish, powershell)' \
'agent:Scan for a dfdu on another host (\`--remote\`)\: reads requests on stdin and writes what it finds to stdout in dfdu'\''s wire format. Not for use by hand' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'dfdu commands' commands "$@"
}
(( $+functions[_dfdu__subcmd__agent_commands] )) ||
_dfdu__subcmd__agent_commands() {
    local commands; commands=()
    _describe -t commands 'dfdu agent commands' commands "$@"
}
(( $+functions[_dfdu__subcmd__cache_commands] )) ||
_dfdu__subcmd__cache_commands() {
    local commands; commands=(
'list:List the cached scans, newest first\: when each was written, its size, its entries and its directory, and where the cache is' \
'clear:Remove every cached scan' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'dfdu cache commands' commands "$@"
}
(( $+functions[_dfdu__subcmd__cache__subcmd__clear_commands] )) ||
_dfdu__subcmd__cache__subcmd__clear_commands() {
    local commands; commands=()
    _describe -t commands 'dfdu cache clear commands' commands "$@"
}
(( $+functions[_dfdu__subcmd__cache__subcmd__help_commands] )) ||
_dfdu__subcmd__cache__subcmd__help_commands() {
    local commands; commands=(
'list:List the cached scans, newest first\: when each was written, its size, its entries and its directory, and where the cache is' \
'clear:Remove every cached scan' \
