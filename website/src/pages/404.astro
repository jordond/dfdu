---
import Base from '../layouts/Base.astro'
import { REPO } from '../site'

const path = Astro.url.pathname
---

<Base title="404: not found · dfdu" description="That page is not on dfdu.app." noindex>
  <div class="tui" id="tui">
    <header class="bar">
      <nav class="tabs" aria-label="Site">
        <a class="brand" href="/">dfdu</a>
        <span class="sep" aria-hidden="true">│</span>
        <a class="tab" href="/">1 About</a>
        <span class="sep" aria-hidden="true">│</span>
        <a class="tab" href="/#install">2 Install</a>
        <span class="sep" aria-hidden="true">│</span>
        <a class="tab" href="/docs/">Docs</a>
      </nav>
      <div class="links">
        <span class="t-err only-wide">● 1 error</span>
        <a href={REPO}>GitHub ↗</a>
      </div>
    </header>
    <div class="bar meta">
      <span>whole scan: <span class="v" id="missing-path">dfdu.app{path}</span></span>
    </div>

    <main class="main">
      <section class="pane" aria-labelledby="title">
        <div class="band">
          <span class="cell">Errors · entries that could not be read</span>
          <span class="cell">1 entry</span>
        </div>
        <div class="hero">
          <div class="pitch">
            <p class="t-err b">error 404</p>
            <h1 id="title">Nothing here.</h1>
            <p>This page was moved, deleted, or never existed.</p>
            <div class="actions">
              <a class="btn btn-fill" href="/">← back to dfdu.app</a>
              <a class="btn btn-line" href="/docs/">read the docs</a>
            </div>
          </div>
        </div>
        <div class="grid head" style="--grid: minmax(0,1fr) 20ch" aria-hidden="true">
          <span class="cell">  entry</span>
          <span class="cell">reason</span>
        </div>
        <div class="list">
          <div class="row grid" style="--grid: minmax(0,1fr) 20ch" aria-current="true">
            <span class="cell"><span class="tree">  </span><span class="label">! <span id="missing-name">{path}</span></span></span>
            <span class="cell">not found (ENOENT)</span>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="hints">
        <span><kbd>esc</kbd> <a href="/">go back</a></span>
      </div>
    </footer>
  </div>
</Base>

<script>
  // One /404.html serves every missing path, so only the browser knows which.
  let path = location.pathname
  try {
    path = decodeURI(path)
  } catch {}
  document.getElementById('missing-path')!.textContent = `dfdu.app${path}`
  document.getElementById('missing-name')!.textContent = path
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape') location.href = '/'
  })
</script>
