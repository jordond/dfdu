---
// The bar above both faces: the wordmark, the TUI/GUI switch and the site links.
// The thumb's position comes from data-face on <html>, set before first paint.
import { LATEST } from '../data/gui'
import { REPO } from '../site'
---

<header class="top">
  <a class="brandmark" href="/">
    <img src="/icon-512.png" alt="" width="28" height="28" />
    <span>dfdu</span>
  </a>
  <div class="mid">
    <div class="switch" role="group" aria-label="Choose which dfdu to show">
      <span class="thumb" aria-hidden="true"></span>
      <button type="button" class="sw sw-tui" data-face-set="tui" aria-pressed="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17l6-5-6-5"></path><path d="M12 19h8"></path></svg>
        <span class="sw-k">TUI</span><span class="sw-s">dfdu</span>
      </button>
      <button type="button" class="sw sw-gui" data-face-set="gui" aria-pressed="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2.5"></rect><path d="M3 9h18"></path><path d="M10 9v11"></path></svg>
        <span class="sw-k">GUI</span><span class="sw-s">dfdu-gui</span>
      </button>
    </div>
  </div>
  <nav class="top-links" aria-label="Site">
    <a href="/docs/">docs</a>
    <a href={LATEST}>v0.3.0<span class="tag-new">GUI</span></a>
    <a href={REPO}>GitHub ↗</a>
  </nav>
</header>
