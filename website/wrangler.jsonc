{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dfdu-web",
  "account_id": "bca591069b9efc9b82571ab6301ca60c",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Preview URLs for pull requests, without serving the site itself on workers.dev.
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "dfdu.app", "custom_domain": true }],
}
