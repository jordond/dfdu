{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitTypeAll(chore)"
  ],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "bump",
  "platformAutomerge": false,
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Automerge minor and patch updates once every CI check, including the coverage gate, passes",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "automerge": true
    },
    {
      "description": "0.x minor bumps are breaking under Cargo semver",
      "matchManagers": ["cargo"],
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "dist generates release.yml: change runners and action pins in dist-workspace.toml, then run `dist generate`",
      "matchFileNames": [".github/workflows/release.yml"],
      "enabled": false
    },
    {
      "description": "MSRV is bumped by hand",
      "matchManagers": ["cargo"],
      "matchDepNames": ["rust"],
      "enabled": false
    },
    {
      "groupName": "github actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"]
    },
    {
      "groupName": "ratatui",
      "matchPackageNames": ["ratatui", "tachyonfx"]
    },
    {
      "groupName": "crossbeam",
      "matchPackageNames": ["/^crossbeam-/"]
    },
    {
      "groupName": "serde",
      "matchPackageNames": ["serde", "serde_json", "toml"]
    },
    {
      "groupName": "platform bindings",
      "matchPackageNames": ["libc", "rustix", "windows-sys", "fuser"]
    },
    {
      "groupName": "website",
      "matchFileNames": ["website/**", ".github/workflows/website.yml"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"]
    },
    {
      "description": "@astrojs/check supports TypeScript 5 and 6 only",
      "matchFileNames": ["website/**"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "groupName": "test tooling",
      "matchPackageNames": ["insta", "tempfile", "loom"]
    }
  ],
  "customManagers": [
    {
      "description": "Versions pinned in website.yml next to a `# renovate:` comment (Bun, Wrangler)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/website\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: \"(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}
