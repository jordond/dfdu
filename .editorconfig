root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonc,js,mjs,ts,astro,css,html,nix}]
indent_style = space
indent_size = 2

# TOML and shell scripts mix styles across the repository: keep each file's own.

[*.md]
trim_trailing_whitespace = false

# Generated or compared byte for byte.
[{assets/man/**,assets/completions/**,**/snapshots/*.snap,Cargo.lock,website/bun.lock}]
trim_trailing_whitespace = unset
insert_final_newline = unset
