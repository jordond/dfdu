<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- The administrator's scan of dfdu-gui from the .deb: pkexec runs the agent script, named
     here by its path, and asks for the password in dfdu's name each time. -->
<policyconfig>
  <vendor>dfdu</vendor>
  <vendor_url>https://github.com/jordond/dfdu</vendor_url>
  <icon_name>app.dfdu</icon_name>
  <action id="app.dfdu.agent">
    <description>Scan as an administrator with dfdu</description>
    <message>Authentication is required for dfdu to scan as an administrator</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/dfdu/dfdu-agent</annotate>
  </action>
</policyconfig>
